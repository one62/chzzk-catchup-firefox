{
  "manifest_version": 3,
  "name": "치지직지직",
  "version": "0.4.0",
  "description": "치지직 자동 배속·따라잡기, 지연·버퍼 표시, 하단 채팅 배치와 Firefox 클립 편집기 호환 기능을 제공합니다.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chzzk-catchup-firefox@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "scripting"],
  "background": { "scripts": ["src/clip-registration.js"] },
  "host_permissions": ["https://chzzk.naver.com/*"],
  "icons": { "48": "icons/chzzk-jijik.svg", "96": "icons/chzzk-jijik.svg" },
  "action": {
    "default_title": "치지직지직",
    "default_icon": "icons/chzzk-jijik.svg",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["src/player-stream.js", "src/server-latency.js", "src/page-bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["src/media.js", "src/auto-policy.js", "src/playback-policy.js", "src/buffer-optimizer.js", "src/latency-average.js", "src/player-label.js", "src/rate-indicator.js", "src/content.js", "src/chat-layout.js"],
      "css": ["src/chat-layout.css"],
      "run_at": "document_idle"
    }
  ]
}
